# LIFELINK Frontend Environment Configuration
# Copy this file to .env.local in the frontend directory

# Backend API and WebSocket URLs
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# Map Tile Provider Configuration
# LIFELINK defaults out-of-the-box to OpenStreetMap tiles with zero watermark and no API key required.
# If you have a CartoDB API key (from carto.com/basemaps/api), provide it here:
NEXT_PUBLIC_CARTO_API_KEY=

# Or override with any standard Slippy map tile URL (e.g., custom tiles, Mapbox, Stamen):
# NEXT_PUBLIC_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
# NEXT_PUBLIC_MAP_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors
