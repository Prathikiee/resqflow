# ResQFlow Environment Configuration
# Copy this file to .env and configure as needed.

# Application Configuration
APP_NAME=ResQFlow
ENVIRONMENT=development
PORT=8000
DEBUG=true

# Database Configuration (Supabase PostgreSQL)
# Format: postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
# If left empty, ResQFlow automatically defaults to local SQLite: sqlite:///./resqflow.db
DATABASE_URL=

# CORS Configuration (comma separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Routing Configuration (OSRM)
# Public OSRM routing endpoint for driving profile
OSRM_BASE_URL=https://router.project-osrm.org

# Regional Coordinates Default: Mangaluru, Karnataka, India
DEFAULT_LATITUDE=12.9141
DEFAULT_LONGITUDE=74.8560
