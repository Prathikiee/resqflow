# ResQFlow Environment Configuration
# Copy this file to .env and configure as needed.

# Application Configuration
APP_NAME=ResQFlow
ENVIRONMENT=development
PORT=8000
DEBUG=true

# Database Configuration (Supabase PostgreSQL)
# Format: postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
# If left empty, ResQFlow automatically defaults to local SQLite: sqlite:///./resqflow.db
DATABASE_URL=

# CORS Configuration (comma separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Routing Configuration (OSRM)
# Public OSRM routing endpoint for driving profile
OSRM_BASE_URL=https://router.project-osrm.org

# Authentication & JWT Security Settings
JWT_SECRET_KEY=lifelink-emergency-command-jwt-secret-key-mangaluru-2026-secure-token
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
DEMO_ACCOUNTS_ENABLED=true

# Regional Coordinates Default: Mangaluru, Karnataka, India
DEFAULT_LATITUDE=12.9141
DEFAULT_LONGITUDE=74.8560

# Frontend Map Tile Provider Configuration
# By default, LIFELINK uses high-reliability OpenStreetMap tiles (zero watermark, no key required).
# To use CartoDB Voyager tiles, provide your free Carto API key:
NEXT_PUBLIC_CARTO_API_KEY=
# Or specify a custom tile URL template:
# NEXT_PUBLIC_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
# NEXT_PUBLIC_MAP_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors

